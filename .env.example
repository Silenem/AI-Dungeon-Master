# PostgreSQL хранит данные пользователей и их персонажей.
# Строка подключения в формате postgresql://<пользователь>:<пароль>@<хост>:<порт>/<база>
POSTGRES_URL=

# Elasticsearch хранит динамическую память приключений.
# Адрес сервера, включая схему http или https и порт.
ELASTICSEARCH_URL=
# Имя индекса или алиаса для динамической памяти.
ELASTICSEARCH_MEMORY_INDEX=
# Ключ доступа, если Elasticsearch использует аутентификацию по API-ключу.
ELASTICSEARCH_API_KEY=

# Redis — необязательный кеш состояния активного приключения для сокращения обращений к PostgreSQL.
# Если Redis используется, укажите redis://<хост>:<порт>/<номер_БД> или rediss:// для TLS.
# В остальных случаях оставьте значение пустым.
REDIS_URL=
