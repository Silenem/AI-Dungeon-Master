# PostgreSQL хранит данные пользователей, персонажей и сохранённых прохождений.
# Строка подключения в формате postgresql://<пользователь>:<пароль>@<хост>:<порт>/<база>
POSTGRES_URL=

# Elasticsearch хранит динамическую память приключений.
# Адрес сервера, включая схему http или https и порт.
ELASTICSEARCH_URL=
# Имя индекса или алиаса для динамической памяти.
ELASTICSEARCH_MEMORY_INDEX=
# Ключ доступа, если Elasticsearch использует аутентификацию по API-ключу.
ELASTICSEARCH_API_KEY=

# Redis хранит состояние активного приключения до переноса в PostgreSQL.
# Укажите redis://<хост>:<порт>/<номер_БД> или rediss:// для TLS.
REDIS_URL=

# Параметры интеграционного стека dev-release.
# Для Compose сгенерируйте отдельный пароль из шестнадцатеричных символов.
POSTGRES_PASSWORD=
AIDM_PORT=18080
COOKIE_SECURE=true

# SMTP для кодов регистрации и 2FA. Адрес AUTH_SMTP_FROM должен быть разрешён провайдером.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
# starttls для 587, tls для 465. plain допустим только для тестового SMTP без авторизации.
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
# Независимый ключ HMAC для кодов, 64 шестнадцатеричных символа (openssl rand -hex 32).
AUTH_CODE_SECRET=
